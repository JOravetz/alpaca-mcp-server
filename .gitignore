# ============================================
# IDE & EDITORS
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ============================================
# OS FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# PROJECT SPECIFIC
# ============================================
# MCP/Claude specific
.claude/
!.claude/commands/
.mcp.json
!.mcp.json.example

# UV package manager (keep lock file)
# Comment out if you want to track uv.lock
# uv.lock

# Monitoring data (sensitive)
monitoring_data/screenshots/*.png
monitoring_data/screenshots/*.jpg
!monitoring_data/screenshots/.gitkeep

# Old documentation (if you want to ignore)
# docs_old/

# Misc files to ignore
stuff
*.personal
*.private
user_data/

# Compiled binaries (track in bin/)
# Don't ignore bin/ directory
!bin/
!bin/*

# ============================================
# GENERATED FILES
# ============================================
*.pyc
*.pyo
*.pyd
.Python
*.so
*.dll
*.dylib

