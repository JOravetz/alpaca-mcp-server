# ============================================
# SECRETS & CREDENTIALS - NEVER COMMIT
# ============================================
.env
.env.*
!.env.example
*.secret
*.key
*.pem
*.credentials
api_keys.txt
secrets/
credentials/
config/local_config.json
config/prod_config.json
# Allow templates
!*.example
!*.template

# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
*.cover
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
# VIRTUAL ENVIRONMENTS
# ============================================
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# ============================================
# LOGS & TEMPORARY FILES
# ============================================
*.log
logs/archive/
logs/*.log
!logs/.gitkeep
monitoring_service.pid
*.pid

# Temporary analysis files
real_time_analysis_*.json
output.avo.2*.dat
combined.sorted.*.lis
*_proof.json
previous_results.json
market_analysis.json
momentum_rss.json
analyzer_stderr*.log

